# Build context: a versioned checkout of NVIDIA/infra-controller. The release
# workflow supplies VERSION and REVISION from the Fleet Intelligence release.
FROM --platform=$TARGETPLATFORM rust:1.97.1-alpine AS builder

ARG VERSION=dev
ARG REVISION=unknown
ENV VERSION=$VERSION \
    CI_COMMIT_SHORT_SHA=$REVISION \
    CARBIDE_VERSION_AVOID_REBUILD=1 \
    FORGE_VERSION_AVOID_REBUILD=1

WORKDIR /src
RUN apk add --no-cache \
      build-base clang cmake perl protobuf-dev protobuf pkgconf \
      openssl-dev openssl-libs-static linux-headers file

COPY . .

RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/usr/local/cargo/git,sharing=locked \
    --mount=type=cache,target=/src/target \
    cargo build --locked --release -p carbide-health --bin forge-hw-health && \
    cp target/release/forge-hw-health /nico-hardware-health && \
    strip /nico-hardware-health && \
    file /nico-hardware-health | tee /tmp/nico-hardware-health.file && \
    grep -Eq "statically linked|static-pie linked" /tmp/nico-hardware-health.file

FROM nvcr.io/nvidia/distroless/static:v4.1.6

ARG VERSION=dev
ARG REVISION=unknown

LABEL org.opencontainers.image.title="NICo Hardware Health" \
      org.opencontainers.image.description="NICo Redfish hardware health collection service" \
      org.opencontainers.image.source="https://github.com/NVIDIA/infra-controller" \
      org.opencontainers.image.version="$VERSION" \
      org.opencontainers.image.revision="$REVISION" \
      org.opencontainers.image.licenses="Apache-2.0"

COPY --from=builder /nico-hardware-health /opt/nico/nico-hardware-health
COPY --from=builder /src/LICENSE /src/THIRD-PARTY-LICENSES /licenses/

USER 65532:65532
ENTRYPOINT ["/opt/nico/nico-hardware-health"]
