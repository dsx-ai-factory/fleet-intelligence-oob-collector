{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["imagePullSecrets", "config", "bmcCollector", "nicoHardwareHealth"],
  "properties": {
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1 }
        }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["secretName", "secretKey"],
      "properties": {
        "secretName": { "type": "string", "minLength": 1 },
        "secretKey": { "type": "string", "minLength": 1 }
      }
    },
    "bmcCollector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "backendUrl", "agentTokenSecretName", "logLevel", "proxy", "intervalSeconds", "insecureTls"],
      "properties": {
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "tag", "pullPolicy"],
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string" },
            "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
          }
        },
        "backendUrl": { "type": "string", "minLength": 1 },
        "agentTokenSecretName": { "type": "string", "minLength": 1 },
        "logLevel": { "type": "string", "minLength": 1 },
        "proxy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["httpProxy", "httpsProxy", "allProxy", "noProxy"],
          "properties": {
            "httpProxy": { "type": "string" },
            "httpsProxy": { "type": "string" },
            "allProxy": { "type": "string" },
            "noProxy": { "type": "string" }
          }
        },
        "intervalSeconds": { "type": "integer", "minimum": 1 },
        "insecureTls": { "type": "boolean" }
      }
    },
    "nicoHardwareHealth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "otlpEndpoint", "metricsPrefix", "image", "tlsSecretName", "service", "otelGateway"],
      "properties": {
        "enabled": { "type": "boolean" },
        "otlpEndpoint": { "type": "string", "pattern": "^$|.*\\S.*" },
        "metricsPrefix": { "type": "string", "pattern": ".*\\S.*" },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "tag", "pullPolicy"],
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string" },
            "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
          }
        },
        "tlsSecretName": { "type": "string" },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "port"],
          "properties": {
            "enabled": { "type": "boolean" },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        },
        "otelGateway": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "image",
            "replicas",
            "terminationGracePeriodSeconds",
            "service",
            "networkPolicy",
            "memoryLimiter",
            "resources"
          ],
          "properties": {
            "enabled": { "type": "boolean" },
            "image": {
              "type": "object",
              "additionalProperties": false,
              "required": ["repository", "tag", "pullPolicy"],
              "properties": {
                "repository": { "type": "string", "pattern": ".*\\S.*" },
                "tag": { "type": "string", "pattern": ".*\\S.*" },
                "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
              }
            },
            "replicas": { "type": "integer", "minimum": 1 },
            "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 },
            "service": {
              "type": "object",
              "additionalProperties": false,
              "required": ["port"],
              "properties": {
                "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
              }
            },
            "networkPolicy": {
              "type": "object",
              "additionalProperties": false,
              "required": ["enabled"],
              "properties": {
                "enabled": { "type": "boolean" }
              }
            },
            "memoryLimiter": {
              "type": "object",
              "additionalProperties": false,
              "required": ["limitPercentage", "spikeLimitPercentage"],
              "properties": {
                "limitPercentage": { "type": "integer", "minimum": 1, "maximum": 100 },
                "spikeLimitPercentage": { "type": "integer", "minimum": 1, "maximum": 100 }
              }
            },
            "resources": {
              "type": "object",
              "additionalProperties": false,
              "required": ["limits", "requests"],
              "properties": {
                "limits": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["cpu", "memory"],
                  "properties": {
                    "cpu": { "type": ["string", "number"] },
                    "memory": { "type": ["string", "number"] }
                  }
                },
                "requests": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["cpu", "memory"],
                  "properties": {
                    "cpu": { "type": ["string", "number"] },
                    "memory": { "type": ["string", "number"] }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
