{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "inventory",
    "credentials",
    "backend",
    "telemetry",
    "imagePullSecrets",
    "proxy",
    "bmcCollector",
    "nicoHardwareHealth",
    "otelGateway"
  ],
  "properties": {
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targets", "computeZone", "nodeGroup", "labels"],
      "properties": {
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["address", "mac"],
            "properties": {
              "kind": {"type": "string", "enum": ["unknown", "compute", "nvswitch", "power_shelf"]},
              "address": {"type": "string", "anyOf": [{"format": "ipv4"}, {"format": "ipv6"}]},
              "port": {"type": "integer", "minimum": 1, "maximum": 65535},
              "mac": {
                "type": "string",
                "pattern": "^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$|^([0-9A-Fa-f]{2}-){5}[0-9A-Fa-f]{2}$|^[0-9A-Fa-f]{12}$"
              },
              "name": {"type": "string", "pattern": ".*\\S.*"},
              "credentialsProfile": {"type": "string", "pattern": ".*\\S.*"},
              "computeZone": {"type": "string", "pattern": ".*\\S.*"},
              "nodeGroup": {"type": "string", "pattern": ".*\\S.*"},
              "labels": {"$ref": "#/definitions/labels"}
            }
          }
        },
        "computeZone": {"type": "string", "pattern": "^$|.*\\S.*"},
        "nodeGroup": {"type": "string", "pattern": "^$|.*\\S.*"},
        "labels": {"$ref": "#/definitions/labels"}
      }
    },
    "credentials": {"$ref": "#/definitions/secretRef"},
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "agentToken"],
      "properties": {
        "url": {"$ref": "#/definitions/httpUrl"},
        "agentToken": {"$ref": "#/definitions/secretRef"}
      }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endpoint"],
      "properties": {
        "endpoint": {"anyOf": [{"const": ""}, {"$ref": "#/definitions/httpUrl"}]}
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$", "maxLength": 253}
        }
      }
    },
    "proxy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "httpProxy", "httpsProxy", "allProxy", "noProxy"],
      "properties": {
        "enabled": {"type": "boolean"},
        "httpProxy": {"$ref": "#/definitions/proxyUrl"},
        "httpsProxy": {"$ref": "#/definitions/proxyUrl"},
        "allProxy": {"$ref": "#/definitions/proxyUrl"},
        "noProxy": {"type": "string"}
      }
    },
    "bmcCollector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "image",
        "resources",
        "nodeSelector",
        "tolerations",
        "affinity",
        "podAnnotations",
        "logLevel",
        "intervalSeconds",
        "targetConcurrency",
        "redfish",
        "latencyProbe"
      ],
      "properties": {
        "enabled": {"type": "boolean"},
        "image": {"$ref": "#/definitions/image"},
        "resources": {"$ref": "#/definitions/resources"},
        "nodeSelector": {"$ref": "#/definitions/nodeSelector"},
        "tolerations": {"$ref": "#/definitions/tolerations"},
        "affinity": {"$ref": "#/definitions/affinity"},
        "podAnnotations": {"$ref": "#/definitions/podAnnotations"},
        "logLevel": {"type": "string", "enum": ["trace", "debug", "info", "warn", "error", "off"]},
        "intervalSeconds": {"type": "integer", "minimum": 1, "maximum": 2147483647},
        "targetConcurrency": {"type": "integer", "minimum": 1, "maximum": 2147483647},
        "redfish": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxInFlight", "requestsPerSecond", "timeoutSeconds", "insecureTls"],
          "properties": {
            "maxInFlight": {"type": "integer", "minimum": 1, "maximum": 2147483647},
            "requestsPerSecond": {"type": "integer", "minimum": 1, "maximum": 2147483647},
            "timeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 2147483647},
            "insecureTls": {"type": "boolean"}
          }
        },
        "latencyProbe": {"$ref": "#/definitions/enabled"}
      }
    },
    "nicoHardwareHealth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "image",
        "resources",
        "nodeSelector",
        "tolerations",
        "affinity",
        "podAnnotations",
        "logLevel"
      ],
      "properties": {
        "enabled": {"type": "boolean"},
        "sensorFetchIntervalSeconds": {"type": ["integer", "null"], "minimum": 1, "maximum": 4294967295},
        "bmcRequestConcurrency": {"type": ["integer", "null"], "minimum": 1, "maximum": 4294967295},
        "rateLimit": {"$ref": "#/definitions/NicoRateLimitSettings"},
        "reachability": {"$ref": "#/definitions/NicoReachabilitySettings"},
        "logs": {"$ref": "#/definitions/NicoLogSettings"},
        "leakDetector": {"$ref": "#/definitions/NicoLeakDetectorSettings"},
        "manager": {"$ref": "#/definitions/NicoPollSettings"},
        "firmware": {"$ref": "#/definitions/NicoFirmwareSettings"},
        "telemetry": {"$ref": "#/definitions/NicoFetchSettings"},
        "metrics": {"$ref": "#/definitions/NicoFetchSettings"},
        "sensors": {"$ref": "#/definitions/NicoSensorSettings"},
        "discovery": {"$ref": "#/definitions/NicoDiscoverySettings"},
        "endpointDiscoveryIntervalSeconds": {"type": ["integer", "null"], "minimum": 1, "maximum": 4294967295},
        "image": {"$ref": "#/definitions/image"},
        "resources": {"$ref": "#/definitions/resources"},
        "nodeSelector": {"$ref": "#/definitions/nodeSelector"},
        "tolerations": {"$ref": "#/definitions/tolerations"},
        "affinity": {"$ref": "#/definitions/affinity"},
        "podAnnotations": {"$ref": "#/definitions/podAnnotations"},
        "logLevel": {"type": "string", "enum": ["trace", "debug", "info", "warn", "error", "off"]}
      }
    },
    "otelGateway": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "image",
        "resources",
        "nodeSelector",
        "tolerations",
        "affinity",
        "podAnnotations",
        "logLevel",
        "replicas"
      ],
      "properties": {
        "enabled": {"type": "boolean"},
        "image": {
          "allOf": [
            {"$ref": "#/definitions/image"},
            {"properties": {"tag": {"minLength": 1, "pattern": "^\\S+$"}}}
          ]
        },
        "resources": {"$ref": "#/definitions/resources"},
        "nodeSelector": {"$ref": "#/definitions/nodeSelector"},
        "tolerations": {"$ref": "#/definitions/tolerations"},
        "affinity": {"$ref": "#/definitions/affinity"},
        "podAnnotations": {"$ref": "#/definitions/podAnnotations"},
        "logLevel": {"type": "string", "enum": ["debug", "info", "warn", "error"]},
        "replicas": {"type": "integer", "minimum": 1, "maximum": 2147483647}
      }
    }
  },
  "definitions": {
    "NicoRateLimitSettings": {"type": ["object", "null"], "additionalProperties": false, "properties": {"enabled": {"type": ["boolean", "null"]}, "bucketBurst": {"type": ["integer", "null"], "minimum": 1, "maximum": 4294967295}, "bucketReplenishMilliseconds": {"type": ["integer", "null"], "minimum": 1, "maximum": 4294967295}, "maxJitterMilliseconds": {"type": ["integer", "null"], "minimum": 0, "maximum": 4294967295}}},
    "NicoReachabilitySettings": {"type": ["object", "null"], "additionalProperties": false, "properties": {"enabled": {"type": ["boolean", "null"]}, "intervalSeconds": {"type": ["integer", "null"], "minimum": 1, "maximum": 4294967295}, "timeoutSeconds": {"type": ["integer", "null"], "minimum": 1, "maximum": 4294967295}, "logMode": {"type": ["string", "null"], "enum": ["all", "unreachable", null]}}},
    "NicoAutoLogSettings": {"type": ["object", "null"], "additionalProperties": false, "properties": {"sseNotAvailableThreshold": {"type": ["integer", "null"], "minimum": 1, "maximum": 4294967295}, "connectFailureWindowSeconds": {"type": ["integer", "null"], "minimum": 1, "maximum": 4294967295}, "connectFailureThreshold": {"type": ["integer", "null"], "minimum": 1, "maximum": 4294967295}, "retrySseAfterDowngrade": {"type": ["boolean", "null"]}}},
    "NicoPeriodicLogSettings": {"type": ["object", "null"], "additionalProperties": false, "properties": {"collectionIntervalSeconds": {"type": ["integer", "null"], "minimum": 1, "maximum": 4294967295}, "stateRefreshIntervalSeconds": {"type": ["integer", "null"], "minimum": 1, "maximum": 4294967295}, "excludeServices": {"type": ["array", "null"], "items": {"type": "string"}}, "skipInitialHistory": {"type": ["boolean", "null"]}}},
    "NicoSseSettings": {"type": ["object", "null"], "additionalProperties": false, "properties": {"initialBackoffSeconds": {"type": ["integer", "null"], "minimum": 1, "maximum": 4294967295}, "maxBackoffSeconds": {"type": ["integer", "null"], "minimum": 1, "maximum": 4294967295}}},
    "NicoLogSettings": {"type": ["object", "null"], "additionalProperties": false, "properties": {"enabled": {"type": ["boolean", "null"]}, "mode": {"type": ["string", "null"], "enum": ["sse", "periodic", "auto", null]}, "sse": {"$ref": "#/definitions/NicoSseSettings"}, "periodic": {"$ref": "#/definitions/NicoPeriodicLogSettings"}, "auto": {"$ref": "#/definitions/NicoAutoLogSettings"}}},
    "NicoLeakDetectorSettings": {"type": ["object", "null"], "additionalProperties": false, "properties": {"enabled": {"type": ["boolean", "null"]}, "pollIntervalSeconds": {"type": ["integer", "null"], "minimum": 1, "maximum": 4294967295}, "stateRefreshIntervalSeconds": {"type": ["integer", "null"], "minimum": 1, "maximum": 4294967295}}},
    "NicoPollSettings": {"type": ["object", "null"], "additionalProperties": false, "properties": {"enabled": {"type": ["boolean", "null"]}, "pollIntervalSeconds": {"type": ["integer", "null"], "minimum": 1, "maximum": 4294967295}}},
    "NicoFirmwareSettings": {"type": ["object", "null"], "additionalProperties": false, "properties": {"enabled": {"type": ["boolean", "null"]}, "refreshIntervalSeconds": {"type": ["integer", "null"], "minimum": 1, "maximum": 4294967295}}},
    "NicoFetchSettings": {"type": ["object", "null"], "additionalProperties": false, "properties": {"enabled": {"type": ["boolean", "null"]}, "fetchIntervalSeconds": {"type": ["integer", "null"], "minimum": 1, "maximum": 4294967295}}},
    "NicoSensorSettings": {"type": ["object", "null"], "additionalProperties": false, "properties": {"enabled": {"type": ["boolean", "null"]}, "includeSensorThresholds": {"type": ["boolean", "null"]}}},
    "NicoDiscoverySettings": {"type": ["object", "null"], "additionalProperties": false, "properties": {"refreshIntervalSeconds": {"type": ["integer", "null"], "minimum": 1, "maximum": 4294967295}, "concurrency": {"type": ["integer", "null"], "minimum": 1, "maximum": 4294967295}}},
    "secretRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["existingSecret", "secretKey"],
      "properties": {
        "existingSecret": {"type": "string", "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$", "maxLength": 253},
        "secretKey": {"type": "string", "pattern": "^[a-zA-Z0-9._-]+$", "maxLength": 253}
      }
    },
    "enabled": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": {"type": "boolean"}
      }
    },
    "labels": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"},
      "additionalProperties": {"type": "string"}
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "pattern": ".*\\S.*"},
        "tag": {"type": "string"},
        "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": {
          "type": "object",
          "additionalProperties": {"type": ["string", "number"]}
        },
        "limits": {
          "type": "object",
          "additionalProperties": {"type": ["string", "number"]}
        }
      }
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "tolerations": {
      "type": "array",
      "items": {"type": "object"}
    },
    "affinity": {"type": "object"},
    "podAnnotations": {
      "type": "object",
      "propertyNames": {
        "not": {"const": "checksum/config"}
      },
      "additionalProperties": {"type": "string"}
    },
    "httpUrl": {"type": "string", "format": "uri", "pattern": "^https?://[^/@\\s?#]+(/[^\\s?#]*)?$"},
    "proxyUrl": {"type": "string", "pattern": "^$|^(https?|socks5h?)://[^/@\\s]+/?$"}
  }
}
