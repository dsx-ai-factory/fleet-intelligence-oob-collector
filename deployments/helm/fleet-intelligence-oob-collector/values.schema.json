{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "inventory",
    "credentials",
    "backend",
    "telemetry",
    "imagePullSecrets",
    "proxy",
    "bmcCollector",
    "nicoHardwareHealth",
    "otelGateway"
  ],
  "properties": {
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targets", "computeZone", "nodeGroup", "labels"],
      "properties": {
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["address", "mac"],
            "properties": {
              "kind": {"type": "string", "enum": ["unknown", "compute", "nvswitch", "power_shelf"]},
              "address": {"type": "string", "anyOf": [{"format": "ipv4"}, {"format": "ipv6"}]},
              "port": {"type": "integer", "minimum": 1, "maximum": 65535},
              "mac": {
                "type": "string",
                "pattern": "^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$|^([0-9A-Fa-f]{2}-){5}[0-9A-Fa-f]{2}$|^[0-9A-Fa-f]{12}$"
              },
              "name": {"type": "string", "pattern": ".*\\S.*", "maxLength": 1024},
              "credentialsProfile": {"type": "string", "pattern": ".*\\S.*"},
              "computeZone": {"type": "string", "pattern": ".*\\S.*", "maxLength": 1024},
              "nodeGroup": {"type": "string", "pattern": ".*\\S.*", "maxLength": 1024},
              "labels": {"$ref": "#/definitions/labels"}
            }
          }
        },
        "computeZone": {"type": "string", "pattern": "^$|.*\\S.*", "maxLength": 1024},
        "nodeGroup": {"type": "string", "pattern": "^$|.*\\S.*", "maxLength": 1024},
        "labels": {"$ref": "#/definitions/labels"}
      }
    },
    "credentials": {"$ref": "#/definitions/secretRef"},
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "agentToken"],
      "properties": {
        "url": {"$ref": "#/definitions/httpUrl"},
        "agentToken": {"$ref": "#/definitions/secretRef"}
      }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endpoint"],
      "properties": {
        "endpoint": {"anyOf": [{"const": ""}, {"$ref": "#/definitions/httpUrl"}]}
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$", "maxLength": 253}
        }
      }
    },
    "proxy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "httpProxy", "httpsProxy", "allProxy", "noProxy"],
      "properties": {
        "enabled": {"type": "boolean"},
        "httpProxy": {"$ref": "#/definitions/proxyUrl"},
        "httpsProxy": {"$ref": "#/definitions/proxyUrl"},
        "allProxy": {"$ref": "#/definitions/proxyUrl"},
        "noProxy": {"type": "string"}
      }
    },
    "bmcCollector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "image",
        "resources",
        "nodeSelector",
        "tolerations",
        "affinity",
        "podAnnotations",
        "logLevel",
        "intervalSeconds",
        "targetConcurrency",
        "redfish",
        "latencyProbe"
      ],
      "properties": {
        "enabled": {"type": "boolean"},
        "image": {"$ref": "#/definitions/image"},
        "resources": {"$ref": "#/definitions/resources"},
        "nodeSelector": {"$ref": "#/definitions/nodeSelector"},
        "tolerations": {"$ref": "#/definitions/tolerations"},
        "affinity": {"$ref": "#/definitions/affinity"},
        "podAnnotations": {"$ref": "#/definitions/podAnnotations"},
        "logLevel": {"type": "string", "enum": ["trace", "debug", "info", "warn", "error", "off"]},
        "intervalSeconds": {"type": "integer", "minimum": 1, "maximum": 2147483647},
        "targetConcurrency": {"type": "integer", "minimum": 1, "maximum": 2147483647},
        "redfish": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxInFlight", "requestsPerSecond", "timeoutSeconds", "insecureTls"],
          "properties": {
            "maxInFlight": {"type": "integer", "minimum": 1, "maximum": 2147483647},
            "requestsPerSecond": {"type": "integer", "minimum": 1, "maximum": 2147483647},
            "timeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 2147483647},
            "insecureTls": {"type": "boolean"}
          }
        },
        "latencyProbe": {"$ref": "#/definitions/enabled"}
      }
    },
    "nicoHardwareHealth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "image",
        "resources",
        "nodeSelector",
        "tolerations",
        "affinity",
        "podAnnotations",
        "logLevel"
      ],
      "properties": {
        "enabled": {"type": "boolean"},
        "image": {"$ref": "#/definitions/image"},
        "resources": {"$ref": "#/definitions/resources"},
        "nodeSelector": {"$ref": "#/definitions/nodeSelector"},
        "tolerations": {"$ref": "#/definitions/tolerations"},
        "affinity": {"$ref": "#/definitions/affinity"},
        "podAnnotations": {"$ref": "#/definitions/podAnnotations"},
        "logLevel": {"type": "string", "enum": ["trace", "debug", "info", "warn", "error", "off"]}
      }
    },
    "otelGateway": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "image",
        "resources",
        "nodeSelector",
        "tolerations",
        "affinity",
        "podAnnotations",
        "logLevel",
        "replicas"
      ],
      "properties": {
        "enabled": {"type": "boolean"},
        "image": {"$ref": "#/definitions/image"},
        "resources": {"$ref": "#/definitions/resources"},
        "nodeSelector": {"$ref": "#/definitions/nodeSelector"},
        "tolerations": {"$ref": "#/definitions/tolerations"},
        "affinity": {"$ref": "#/definitions/affinity"},
        "podAnnotations": {"$ref": "#/definitions/podAnnotations"},
        "logLevel": {"type": "string", "enum": ["debug", "info", "warn", "error"]},
        "replicas": {"type": "integer", "minimum": 1, "maximum": 2147483647}
      }
    }
  },
  "definitions": {
    "secretRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["existingSecret", "secretKey"],
      "properties": {
        "existingSecret": {"type": "string", "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$", "maxLength": 253},
        "secretKey": {"type": "string", "pattern": "^[a-zA-Z0-9._-]+$", "maxLength": 253}
      }
    },
    "enabled": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": {"type": "boolean"}
      }
    },
    "labels": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$",
        "not": {
          "enum": [
            "bmc_endpoint",
            "bmc_ip",
            "collector_type",
            "component_type",
            "driver_version",
            "endpoint_ip",
            "endpoint_key",
            "endpoint_mac",
            "gpu_chassis_serial",
            "gpu_model",
            "gpu_serial",
            "gpu_uuid",
            "machine_id",
            "machine_serial",
            "machine_slot_number",
            "machine_tray_index",
            "machine_name",
            "compute_zone",
            "node_group",
            "nvlink_domain_uuid",
            "oob",
            "power_shelf_id",
            "power_shelf_serial_number",
            "rack_id",
            "serial_number",
            "switch_endpoint",
            "switch_endpoint_role",
            "switch_id",
            "switch_ip",
            "switch_is_primary",
            "switch_serial_number",
            "switch_slot_number",
            "switch_tray_index",
            "system_uuid"
          ]
        }
      },
      "additionalProperties": {"type": "string", "maxLength": 1024}
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "pattern": ".*\\S.*"},
        "tag": {"type": "string"},
        "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": {
          "type": "object",
          "additionalProperties": {"type": ["string", "number"]}
        },
        "limits": {
          "type": "object",
          "additionalProperties": {"type": ["string", "number"]}
        }
      }
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "tolerations": {
      "type": "array",
      "items": {"type": "object"}
    },
    "affinity": {"type": "object"},
    "podAnnotations": {
      "type": "object",
      "propertyNames": {
        "not": {"const": "checksum/config"}
      },
      "additionalProperties": {"type": "string"}
    },
    "httpUrl": {"type": "string", "format": "uri", "pattern": "^https?://[^/@\\s?#]+(/[^\\s?#]*)?$"},
    "proxyUrl": {"type": "string", "pattern": "^$|^(https?|socks5h?)://[^/@\\s]+/?$"}
  }
}
