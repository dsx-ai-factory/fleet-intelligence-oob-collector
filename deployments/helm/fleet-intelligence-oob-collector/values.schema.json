{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "inventory",
    "credentials",
    "backend",
    "telemetry",
    "imagePullSecrets",
    "proxy",
    "bmcCollector",
    "nicoHardwareHealth",
    "otelGateway"
  ],
  "properties": {
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targets", "computeZone", "nodeGroup", "labels"],
      "properties": {
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["address", "mac"],
            "properties": {
              "kind": {"type": "string", "enum": ["unknown", "compute", "nvswitch", "power_shelf"]},
              "address": {"type": "string", "anyOf": [{"format": "ipv4"}, {"format": "ipv6"}]},
              "port": {"type": "integer", "minimum": 1, "maximum": 65535},
              "mac": {
                "type": "string",
                "pattern": "^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$|^([0-9A-Fa-f]{2}-){5}[0-9A-Fa-f]{2}$|^[0-9A-Fa-f]{12}$"
              },
              "name": {"type": "string", "pattern": ".*\\S.*"},
              "credentialsProfile": {"type": "string", "pattern": ".*\\S.*"},
              "computeZone": {"type": "string", "pattern": ".*\\S.*"},
              "nodeGroup": {"type": "string", "pattern": ".*\\S.*"},
              "labels": {"$ref": "#/definitions/labels"}
            }
          }
        },
        "computeZone": {"type": "string", "pattern": "^$|.*\\S.*"},
        "nodeGroup": {"type": "string", "pattern": "^$|.*\\S.*"},
        "labels": {"$ref": "#/definitions/labels"}
      }
    },
    "credentials": {"$ref": "#/definitions/secretRef"},
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "enrollmentToken"],
      "properties": {
        "url": {"$ref": "#/definitions/httpUrl"},
        "enrollmentToken": {"$ref": "#/definitions/secretRef"}
      }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endpoint"],
      "properties": {
        "endpoint": {"anyOf": [{"const": ""}, {"$ref": "#/definitions/httpUrl"}]}
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$", "maxLength": 253}
        }
      }
    },
    "proxy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "httpProxy", "httpsProxy", "allProxy", "noProxy"],
      "properties": {
        "enabled": {"type": "boolean"},
        "httpProxy": {"$ref": "#/definitions/proxyUrl"},
        "httpsProxy": {"$ref": "#/definitions/proxyUrl"},
        "allProxy": {"$ref": "#/definitions/proxyUrl"},
        "noProxy": {"type": "string"}
      }
    },
    "bmcCollector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "image",
        "resources",
        "nodeSelector",
        "tolerations",
        "affinity",
        "podAnnotations",
        "logLevel",
        "intervalSeconds",
        "targetConcurrency",
        "redfish",
        "latencyProbe"
      ],
      "properties": {
        "enabled": {"type": "boolean"},
        "image": {"$ref": "#/definitions/image"},
        "resources": {"$ref": "#/definitions/resources"},
        "nodeSelector": {"$ref": "#/definitions/nodeSelector"},
        "tolerations": {"$ref": "#/definitions/tolerations"},
        "affinity": {"$ref": "#/definitions/affinity"},
        "podAnnotations": {"$ref": "#/definitions/podAnnotations"},
        "logLevel": {"type": "string", "enum": ["trace", "debug", "info", "warn", "error", "off"]},
        "intervalSeconds": {"type": "integer", "minimum": 1, "maximum": 2147483647},
        "targetConcurrency": {"type": "integer", "minimum": 1, "maximum": 2147483647},
        "redfish": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxInFlight", "requestsPerSecond", "timeoutSeconds", "insecureTls"],
          "properties": {
            "maxInFlight": {"type": "integer", "minimum": 1, "maximum": 2147483647},
            "requestsPerSecond": {"type": "integer", "minimum": 1, "maximum": 2147483647},
            "timeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 2147483647},
            "insecureTls": {"type": "boolean"}
          }
        },
        "latencyProbe": {"$ref": "#/definitions/enabled"}
      }
    },
    "nicoHardwareHealth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "image",
        "resources",
        "nodeSelector",
        "tolerations",
        "affinity",
        "podAnnotations",
        "logLevel",
        "resourceStatus"
      ],
      "properties": {
        "enabled": {"type": "boolean"},
        "config": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sensorFetchIntervalSeconds": {"type": ["integer", "null"], "minimum": 1, "maximum": 4294967295},
            "bmcRequestConcurrency": {"type": ["integer", "null"], "minimum": 1, "maximum": 4294967295},
            "endpointDiscoveryIntervalSeconds": {"type": ["integer", "null"], "minimum": 1, "maximum": 4294967295},
            "discoveryRefreshIntervalSeconds": {"type": ["integer", "null"], "minimum": 1, "maximum": 4294967295},
            "discoveryConcurrency": {"type": ["integer", "null"], "minimum": 1, "maximum": 4294967295},
            "sensorsEnabled": {"type": ["boolean", "null"]},
            "includeSensorThresholds": {"type": ["boolean", "null"]},
            "metricsEnabled": {"type": ["boolean", "null"]},
            "metricsFetchIntervalSeconds": {"type": ["integer", "null"], "minimum": 1, "maximum": 4294967295},
            "telemetryEnabled": {"type": ["boolean", "null"]},
            "telemetryFetchIntervalSeconds": {"type": ["integer", "null"], "minimum": 1, "maximum": 4294967295},
            "firmwareEnabled": {"type": ["boolean", "null"]},
            "firmwareRefreshIntervalSeconds": {"type": ["integer", "null"], "minimum": 1, "maximum": 4294967295},
            "managerEnabled": {"type": ["boolean", "null"]},
            "managerPollIntervalSeconds": {"type": ["integer", "null"], "minimum": 1, "maximum": 4294967295},
            "leakDetectorEnabled": {"type": ["boolean", "null"]},
            "leakDetectorPollIntervalSeconds": {"type": ["integer", "null"], "minimum": 1, "maximum": 4294967295},
            "leakDetectorStateRefreshIntervalSeconds": {"type": ["integer", "null"], "minimum": 1, "maximum": 4294967295},
            "logsEnabled": {"type": ["boolean", "null"]},
            "logsMode": {"type": ["string", "null"], "enum": ["sse", "periodic", "auto", null]},
            "logsSseInitialBackoffSeconds": {"type": ["integer", "null"], "minimum": 1, "maximum": 4294967295},
            "logsSseMaxBackoffSeconds": {"type": ["integer", "null"], "minimum": 1, "maximum": 4294967295},
            "logsCollectionIntervalSeconds": {"type": ["integer", "null"], "minimum": 1, "maximum": 4294967295},
            "logsStateRefreshIntervalSeconds": {"type": ["integer", "null"], "minimum": 1, "maximum": 4294967295},
            "logsExcludeServices": {"type": ["array", "null"], "items": {"type": "string"}},
            "logsSkipInitialHistory": {"type": ["boolean", "null"]},
            "logsAutoSseNotAvailableThreshold": {"type": ["integer", "null"], "minimum": 1, "maximum": 4294967295},
            "logsAutoConnectFailureWindowSeconds": {"type": ["integer", "null"], "minimum": 1, "maximum": 4294967295},
            "logsAutoConnectFailureThreshold": {"type": ["integer", "null"], "minimum": 1, "maximum": 4294967295},
            "logsAutoRetrySseAfterDowngrade": {"type": ["boolean", "null"]},
            "reachabilityEnabled": {"type": ["boolean", "null"]},
            "reachabilityIntervalSeconds": {"type": ["integer", "null"], "minimum": 1, "maximum": 4294967295},
            "reachabilityTimeoutSeconds": {"type": ["integer", "null"], "minimum": 1, "maximum": 4294967295},
            "reachabilityLogMode": {"type": ["string", "null"], "enum": ["all", "unreachable", null]},
            "rateLimitEnabled": {"type": ["boolean", "null"]},
            "rateLimitBucketBurst": {"type": ["integer", "null"], "minimum": 1, "maximum": 4294967295},
            "rateLimitBucketReplenishMilliseconds": {"type": ["integer", "null"], "minimum": 1, "maximum": 4294967295},
            "rateLimitMaxJitterMilliseconds": {"type": ["integer", "null"], "minimum": 0, "maximum": 4294967295}
          }
        },
        "image": {"$ref": "#/definitions/image"},
        "resources": {"$ref": "#/definitions/resources"},
        "nodeSelector": {"$ref": "#/definitions/nodeSelector"},
        "tolerations": {"$ref": "#/definitions/tolerations"},
        "affinity": {"$ref": "#/definitions/affinity"},
        "podAnnotations": {"$ref": "#/definitions/podAnnotations"},
        "logLevel": {"type": "string", "enum": ["trace", "debug", "info", "warn", "error", "off"]},
        "resourceStatus": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "firmwarePollIntervalSeconds"],
          "properties": {
            "enabled": {"type": "boolean"},
            "firmwarePollIntervalSeconds": {"type": "integer", "minimum": 1, "maximum": 2147483647}
          }
        }
      }
    },
    "otelGateway": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "image",
        "resources",
        "nodeSelector",
        "tolerations",
        "affinity",
        "podAnnotations",
        "logLevel",
        "replicas"
      ],
      "properties": {
        "enabled": {"type": "boolean"},
        "image": {
          "allOf": [
            {"$ref": "#/definitions/image"},
            {"properties": {"tag": {"minLength": 1, "pattern": "^\\S+$"}}}
          ]
        },
        "resources": {"$ref": "#/definitions/resources"},
        "nodeSelector": {"$ref": "#/definitions/nodeSelector"},
        "tolerations": {"$ref": "#/definitions/tolerations"},
        "affinity": {"$ref": "#/definitions/affinity"},
        "podAnnotations": {"$ref": "#/definitions/podAnnotations"},
        "logLevel": {"type": "string", "enum": ["debug", "info", "warn", "error"]},
        "replicas": {"type": "integer", "minimum": 1, "maximum": 2147483647}
      }
    }
  },
  "definitions": {
    "secretRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["existingSecret", "secretKey"],
      "properties": {
        "existingSecret": {"type": "string", "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$", "maxLength": 253},
        "secretKey": {"type": "string", "pattern": "^[a-zA-Z0-9._-]+$", "maxLength": 253}
      }
    },
    "enabled": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": {"type": "boolean"}
      }
    },
    "labels": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"},
      "additionalProperties": {"type": "string"}
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "pattern": ".*\\S.*"},
        "tag": {"type": "string"},
        "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": {
          "type": "object",
          "additionalProperties": {"type": ["string", "number"]}
        },
        "limits": {
          "type": "object",
          "additionalProperties": {"type": ["string", "number"]}
        }
      }
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "tolerations": {
      "type": "array",
      "items": {"type": "object"}
    },
    "affinity": {"type": "object"},
    "podAnnotations": {
      "type": "object",
      "propertyNames": {
        "not": {"const": "checksum/config"}
      },
      "additionalProperties": {"type": "string"}
    },
    "httpUrl": {"type": "string", "format": "uri", "pattern": "^https?://[^/@\\s?#]+(/[^\\s?#]*)?$"},
    "proxyUrl": {"type": "string", "pattern": "^$|^(https?|socks5h?)://[^/@\\s]+/?$"}
  }
}
