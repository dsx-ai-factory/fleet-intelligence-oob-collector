{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["imagePullSecrets", "config", "credentials", "bmcCollector", "nicoHardwareHealth", "otelGateway"],
  "properties": {
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1 }
        }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["configMapName", "configKey"],
      "properties": {
        "configMapName": { "type": "string", "minLength": 1 },
        "configKey": { "type": "string", "minLength": 1 }
      }
    },
    "credentials": {
      "type": "object",
      "additionalProperties": false,
      "required": ["secrets"],
      "properties": {
        "secrets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "target"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "target": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._-]+$",
                "not": { "enum": [".", ".."] }
              }
            }
          }
        }
      }
    },
    "bmcCollector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "backendUrl", "agentTokenSecretName", "logLevel", "proxy", "intervalSeconds", "insecureTls", "targetConcurrency", "bmcMaxInFlight", "bmcRequestsPerSecond", "bmcBurst", "timeoutSeconds"],
      "properties": {
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "tag", "pullPolicy"],
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string" },
            "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
          }
        },
        "backendUrl": { "type": "string", "minLength": 1 },
        "agentTokenSecretName": { "type": "string", "minLength": 1 },
        "logLevel": { "type": "string", "minLength": 1 },
        "proxy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["httpProxy", "httpsProxy", "allProxy", "noProxy"],
          "properties": {
            "httpProxy": { "type": "string" },
            "httpsProxy": { "type": "string" },
            "allProxy": { "type": "string" },
            "noProxy": { "type": "string" }
          }
        },
        "intervalSeconds": { "type": "integer", "minimum": 1 },
        "insecureTls": { "type": "boolean" },
        "targetConcurrency": { "type": "integer", "minimum": 1 },
        "bmcMaxInFlight": { "type": "integer", "minimum": 1 },
        "bmcRequestsPerSecond": { "type": "integer", "minimum": 1 },
        "bmcBurst": { "type": "integer", "minimum": 1 },
        "timeoutSeconds": { "type": "integer", "minimum": 1 }
      }
    },
    "nicoHardwareHealth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "otlpEndpoint", "metricsPrefix", "image", "tlsSecretName", "service"],
      "properties": {
        "enabled": { "type": "boolean" },
        "otlpEndpoint": { "type": "string", "pattern": "^$|.*\\S.*" },
        "metricsPrefix": { "type": "string", "pattern": ".*\\S.*" },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "tag", "pullPolicy"],
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string" },
            "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
          }
        },
        "tlsSecretName": { "type": "string" },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "port"],
          "properties": {
            "enabled": { "type": "boolean" },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        }
      }
    },
    "otelGateway": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "image",
        "replicas",
        "terminationGracePeriodSeconds",
        "enroll",
        "backendEndpoint",
        "service",
        "networkPolicy",
        "podDisruptionBudget",
        "memoryLimiter",
        "resources"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "tag", "pullPolicy"],
          "properties": {
            "repository": { "type": "string", "pattern": ".*\\S.*" },
            "tag": { "type": "string", "pattern": ".*\\S.*" },
            "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
          }
        },
        "replicas": { "type": "integer", "minimum": 1 },
        "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 },
        "enroll": {
          "type": "object",
          "additionalProperties": false,
          "required": ["endpoint", "existingSecret", "secretKey"],
          "properties": {
            "endpoint": { "type": "string", "pattern": "^$|.*\\S.*" },
            "existingSecret": { "type": "string", "pattern": "^$|.*\\S.*" },
            "secretKey": { "type": "string", "pattern": ".*\\S.*" }
          }
        },
        "backendEndpoint": { "type": "string", "pattern": "^$|.*\\S.*" },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "required": ["grpcPort", "httpPort"],
          "properties": {
            "grpcPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "httpPort": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        },
        "networkPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" }
          }
        },
        "podDisruptionBudget": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "minAvailable"],
          "properties": {
            "enabled": { "type": "boolean" },
            "minAvailable": { "type": "integer", "minimum": 0 }
          }
        },
        "memoryLimiter": {
          "type": "object",
          "additionalProperties": false,
          "required": ["limitPercentage", "spikeLimitPercentage"],
          "properties": {
            "limitPercentage": { "type": "integer", "minimum": 1, "maximum": 100 },
            "spikeLimitPercentage": { "type": "integer", "minimum": 1, "maximum": 100 }
          }
        },
        "resources": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  }
}
