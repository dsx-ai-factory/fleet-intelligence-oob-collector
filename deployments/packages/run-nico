set -eu
: "${FLEETINT_OTLP_ENDPOINT:=http://127.0.0.1:4317}"
: "${FLEETINT_NICO_RESOURCE_STATUS_ENABLED:=true}"
: "${FLEETINT_NICO_RESOURCE_STATUS_FIRMWARE_POLL_INTERVAL_SECONDS:=1800}"
: "${FLEETINT_NICO_LOG_LEVEL:=warn}"
case "$FLEETINT_NICO_LOG_LEVEL" in
    trace|debug|info|warn|error|off) ;;
    *) echo 'FLEETINT_NICO_LOG_LEVEL must be trace, debug, info, warn, error, or off' >&2; exit 2 ;;
esac
umask 077
# RuntimeDirectory is private to this service account. A fresh directory avoids
# following pre-existing files, and failed rendering never starts NICo.
work=$(mktemp -d /run/fleetint-nico-health/config.XXXXXXXX)
trap 'rm -rf -- "$work"' EXIT HUP INT TERM
set -- render-nico-config \
    --config /etc/fleetint-oob/config.toml \
    --output "$work/config.toml" \
    --otlp-endpoint "$FLEETINT_OTLP_ENDPOINT" \
    --metrics-endpoint "${FLEETINT_METRICS_ENDPOINT:-127.0.0.1:9009}" \
    --resource-status-firmware-poll-interval-seconds "$FLEETINT_NICO_RESOURCE_STATUS_FIRMWARE_POLL_INTERVAL_SECONDS"
case "$FLEETINT_NICO_RESOURCE_STATUS_ENABLED" in
    true) ;;
    false) set -- "$@" --disable-resource-status-collection ;;
    *)
        echo "FLEETINT_NICO_RESOURCE_STATUS_ENABLED must be true or false" >&2
        exit 2
        ;;
esac
/usr/bin/bmc-collector "$@"
# systemd removes RuntimeDirectory after the process exits, including crashes.
trap - EXIT HUP INT TERM
RUST_LOG="$FLEETINT_NICO_LOG_LEVEL" exec /usr/lib/fleetint-oob/nico-hardware-health "$work/config.toml"
