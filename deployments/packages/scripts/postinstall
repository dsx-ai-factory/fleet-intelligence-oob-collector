set -eu
unit=fleetint-oob.target
if command -v deb-systemd-helper >/dev/null 2>&1; then
    deb-systemd-helper unmask "$unit"
    deb-systemd-helper update-state "$unit"
fi
install -d -m 0700 -o root -g root /etc/fleetint-oob/credentials
chmod 0600 /etc/fleetint-oob/service.conf
if [ -d /run/systemd/system ]; then
    systemctl daemon-reload
fi
