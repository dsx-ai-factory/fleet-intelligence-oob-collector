set -eu
case "${1:-}" in
    configure|abort-upgrade|abort-deconfigure|abort-remove) ;;
    *) exit 0 ;;
esac
# sysusers and tmpfiles perform account and permission changes using the distro's
# filesystem handling, including alternate-root installations.
systemd-sysusers ${DPKG_ROOT:+--root="$DPKG_ROOT"} /usr/lib/sysusers.d/fleetint-oob.conf
if [ -n "${DPKG_ROOT:-}" ]; then
    # Chrootless installs need not contain executable tools or a dynamic loader.
    if ! awk -F: '
        FILENAME == ARGV[1] && $1 == "fleetint-oob" {
            users++
            uid = $3
            primary_gid = $4
        }
        FILENAME == ARGV[2] && $1 == "fleetint-oob" {
            groups++
            group_gid = $3
        }
        END {
            exit !(users == 1 && groups == 1 &&
                uid ~ /^[0-9]+$/ && uid > 0 && uid < 4294967295 &&
                primary_gid ~ /^[0-9]+$/ && primary_gid > 0 && primary_gid < 4294967295 &&
                group_gid ~ /^[0-9]+$/ && group_gid == primary_gid)
        }
    ' "$DPKG_ROOT/etc/passwd" "$DPKG_ROOT/etc/group"; then
        echo 'fleetint-oob must be a non-root account with its own primary group' >&2; exit 1
    fi
else
    account_uid=$(id -u fleetint-oob)
    account_gid=$(id -g fleetint-oob)
    account_group=$(id -gn fleetint-oob)
    if [ "$account_uid" -eq 0 ] || [ "$account_gid" -eq 0 ] || [ "$account_group" != fleetint-oob ]; then
        echo 'fleetint-oob must be a non-root account with its own primary group' >&2; exit 1
    fi
fi
systemd-tmpfiles ${DPKG_ROOT:+--root="$DPKG_ROOT"} --create /usr/lib/fleetint-oob/permissions.conf
for unit in fleetint-oob.target fleetint-oob-collector.service fleetint-nico-health.service fleetint-otel-gateway.service; do
    if deb-systemd-helper debian-installed "$unit"; then
        deb-systemd-helper unmask "$unit" >/dev/null || echo "[WARNING] Could not unmask $unit" >&2
        if deb-systemd-helper --quiet was-enabled "$unit"; then
            deb-systemd-helper enable "$unit" >/dev/null || echo "[WARNING] Could not restore enablement for $unit" >&2
        fi
    fi
    deb-systemd-helper update-state "$unit" >/dev/null || echo "[WARNING] Could not save state for $unit" >&2
done
if [ -z "${DPKG_ROOT:-}" ] && [ -d /run/systemd/system ]; then
    systemctl --system daemon-reload >/dev/null || echo '[WARNING] Could not reload systemd units' >&2
    if [ "$1" = configure ] && [ -n "${2:-}" ]; then
        for unit in fleetint-oob-collector.service fleetint-nico-health.service fleetint-otel-gateway.service; do
            if systemctl is-active --quiet "$unit"; then
                deb-systemd-invoke restart "$unit" || echo "[WARNING] Could not restart $unit after upgrade" >&2
            else
                status=$?
                case "$status" in 3|4) ;; *) echo "[WARNING] Could not query state of $unit" >&2 ;; esac
            fi
        done
    fi
fi
