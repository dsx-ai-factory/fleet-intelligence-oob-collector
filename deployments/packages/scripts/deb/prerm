set -eu
case "${1:-}" in
    remove|deconfigure)
        if [ -z "${DPKG_ROOT:-}" ] && [ -d /run/systemd/system ]; then
            deb-systemd-invoke stop fleetint-oob.target
            systemctl --no-reload disable fleetint-oob.target
        fi
        ;;
esac
