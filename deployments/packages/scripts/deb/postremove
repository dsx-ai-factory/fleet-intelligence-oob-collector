set -eu
unit=fleetint-oob.target
case "${1:-}" in
    remove|purge)
        if [ -d /run/systemd/system ] && command -v systemctl >/dev/null 2>&1; then
            systemctl daemon-reload
        fi
        ;;
esac
if command -v deb-systemd-helper >/dev/null 2>&1; then
    case "${1:-}" in
        remove) deb-systemd-helper mask "$unit" ;;
        purge) deb-systemd-helper purge "$unit"; deb-systemd-helper unmask "$unit" ;;
    esac
fi
