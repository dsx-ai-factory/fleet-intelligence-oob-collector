[Unit]
Description=Fleet Intelligence authenticated telemetry gateway
Wants=network-online.target
After=network-online.target
PartOf=fleetint-oob.target

[Service]
EnvironmentFile=/etc/fleetint-oob/service.conf
LoadCredential=agent-token:/etc/fleetint-oob/agent-token
ExecStart=/usr/lib/fleetint-oob/start-gateway
Restart=on-failure
RestartSec=10s

[Install]
WantedBy=multi-user.target
