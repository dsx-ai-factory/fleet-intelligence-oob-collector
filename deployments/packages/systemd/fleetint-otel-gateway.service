[Unit]
Description=Fleet Intelligence authenticated telemetry gateway
Wants=network-online.target
After=network-online.target
PartOf=fleetint-oob.target

[Service]
EnvironmentFile=/etc/fleetint-oob/service.conf
ExecStart=/usr/lib/fleetint-oob/otel-gateway --config=/etc/fleetint-oob/gateway.yaml
Restart=on-failure
RestartSec=10s

[Install]
WantedBy=multi-user.target
