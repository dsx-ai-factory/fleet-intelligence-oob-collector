[Unit]
Description=Fleet Intelligence NICo hardware health
Wants=network-online.target fleetint-otel-gateway.service
After=network-online.target fleetint-otel-gateway.service
PartOf=fleetint-oob.target

[Service]
User=fleetint-oob
Group=fleetint-oob
EnvironmentFile=/etc/fleetint-oob/service.conf
RuntimeDirectory=fleetint-nico-health
RuntimeDirectoryMode=0700
ExecStart=/usr/lib/fleetint-oob/run-nico
Restart=on-failure
RestartSec=10s
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
LockPersonality=true

[Install]
WantedBy=multi-user.target
