[Unit]
Description=Fleet Intelligence OOB inventory and attestation
Wants=network-online.target
After=network-online.target
PartOf=fleetint-oob.target

[Service]
EnvironmentFile=/etc/fleetint-oob/service.conf
ExecStart=/usr/bin/bmc-collector run --config /etc/fleetint-oob/config.toml --interval-seconds ${FLEETINT_INTERVAL_SECONDS}
Restart=on-failure
RestartSec=10s
KillSignal=SIGINT

[Install]
WantedBy=multi-user.target
