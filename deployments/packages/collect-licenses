# Copy notices only for dependencies in this build, keeping unrelated Cargo
# cache contents out of the distributable package.
set -eu
package=$1
destination=$2
mkdir -p "$destination/licenses"
cargo tree --locked --offline --package "$package" --edges normal,build \
    --prefix none --format '{p}: {l}' > "$destination/dependencies.txt"
awk '$2 ~ /^v/ {sub(/^v/, "", $2); sub(/:$/, "", $2); print $1 "-" $2}' \
    "$destination/dependencies.txt" | sort -u > "$destination/package-versions.txt"
for source in "${CARGO_HOME:-$HOME/.cargo}"/registry/src/index.crates.io-*/*; do
    [ -d "$source" ] || continue
    name=$(basename "$source")
    grep -Fqx "$name" "$destination/package-versions.txt" || continue
    output="$destination/licenses/$name"
    mkdir -p "$output"
    (cd "$source" && find . -type f \( -iname 'license*' -o -iname 'notice*' -o -iname 'copying*' -o -iname 'copyright*' \) -exec cp --parents -t "$output/" '{}' +)
done
